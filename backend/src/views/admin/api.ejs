<%- include('partials/header', { title: 'Application API', activeNav: 'api', contentHeader: '<h1>Application API<small>Control access credentials for managing this Panel via the API.</small></h1><ol class="breadcrumb"><li><a href="/admin">Admin</a></li><li class="active">Application API</li></ol>' }) %>

<% if (newToken) { %>
<div class="row">
    <div class="col-xs-12">
        <div class="alert alert-warning">
            <strong>New Application API Key Created:</strong> <code><%= newToken %></code> (Copy this token now, it will not be shown again.)
        </div>
    </div>
</div>
<% } %>

<div class="row">
    <div class="col-md-8">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Credentials List</h3>
            </div>
            <div class="box-body table-responsive no-padding">
                <table class="table table-hover">
                    <tbody>
                        <tr>
                            <th>Key</th>
                            <th>Memo</th>
                            <th>Last Used</th>
                            <th>Created</th>
                            <th></th>
                        </tr>
                        <% if (keys.length === 0) { %>
                        <tr><td colspan="5" class="text-muted text-center">No Application API keys created yet.</td></tr>
                        <% } %>
                        <% for (const k of keys) { %>
                        <tr>
                            <td><code><%= k.identifier %></code></td>
                            <td><%= k.memo || '-' %></td>
                            <td><%= k.last_used_at || 'Never' %></td>
                            <td><%= k.created_at %></td>
                            <td>
                                <form action="/admin/api/delete/<%= k.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-trash-o"></i></button>
                                </form>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="box box-success">
            <div class="box-header with-border"><h3 class="box-title">Create New Key</h3></div>
            <form action="/admin/api/new" method="POST">
                <div class="box-body">
                    <div class="form-group">
                        <label>Description / Memo</label>
                        <input type="text" name="memo" class="form-control" required placeholder="Billing integration key">
                    </div>
                </div>
                <div class="box-footer">
                    <button type="submit" class="btn btn-success btn-sm pull-right">Create Credentials</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
