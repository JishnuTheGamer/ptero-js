<%- include('partials/header', { title: 'Local Allocations', activeNav: 'allocations', contentHeader: '<h1>Local Node Allocations<small>Manage IP and port allocations on this single-node instance.</small></h1><ol class="breadcrumb"><li><a href="/admin">Admin</a></li><li class="active">Allocations</li></ol>' }) %>

<div class="row">
    <div class="col-sm-8">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Existing Allocations (<%= node.name %>)</h3>
                <div class="box-tools pull-right">
                    <form id="massDeleteAllocationsForm" action="/admin/allocations/delete-mass" method="POST" style="display:inline;">
                        <button type="submit" id="massDeleteAllocationsBtn" class="btn btn-xs btn-danger" disabled>
                            <i class="fa fa-trash-o"></i> Delete Selected (<span id="selectedAllocationsCount">0</span>)
                        </button>
                    </form>
                </div>
            </div>
            <div class="box-body table-responsive no-padding">
                <table class="table table-hover">
                    <tbody>
                        <tr>
                            <th class="text-center" style="width: 36px;">
                                <input type="checkbox" id="selectAllAllocations" title="Select all unused allocations" aria-label="Select all unused allocations">
                            </th>
                            <th>IP Address</th>
                            <th>IP Alias</th>
                            <th>Port</th>
                            <th>Assigned To</th>
                            <th></th>
                        </tr>
                        <% for (const a of allocations) { %>
                        <tr>
                            <td class="text-center">
                                <% if (!a.server_id) { %>
                                    <input type="checkbox" class="allocation-checkbox" name="ids" value="<%= a.id %>" form="massDeleteAllocationsForm" aria-label="Select allocation <%= a.ip %>:<%= a.port %>">
                                <% } else { %>
                                    <input type="checkbox" disabled title="In use by <%= a.server_name || 'server' %>" aria-label="Allocation in use by server">
                                <% } %>
                            </td>
                            <td><code><%= a.ip %></code></td>
                            <td><%= a.ip_alias || '-' %></td>
                            <td><code><%= a.port %></code></td>
                            <td>
                                <% if (a.server_name) { %>
                                    <a href="/admin/servers/view/<%= a.server_id %>"><%= a.server_name %></a>
                                <% } else { %>
                                    <span class="label label-default">Unassigned</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (!a.server_id) { %>
                                <form action="/admin/allocations/delete/<%= a.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-trash-o"></i></button>
                                </form>
                                <% } %>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="box box-success">
            <div class="box-header with-border"><h3 class="box-title">Assign New Allocations</h3></div>
            <form action="/admin/allocations" method="POST">
                <div class="box-body">
                    <div class="form-group">
                        <label>IP Address</label>
                        <input type="text" name="ip" class="form-control" value="0.0.0.0" required>
                    </div>
                    <div class="form-group">
                        <label>IP Alias (Optional)</label>
                        <input type="text" name="ip_alias" class="form-control" placeholder="play.example.com">
                    </div>
                    <div class="form-group">
                        <label>Ports (Single or Range, e.g. 25576-25580)</label>
                        <input type="text" name="ports" class="form-control" placeholder="25576" required>
                    </div>
                </div>
                <div class="box-footer">
                    <button type="submit" class="btn btn-success btn-sm pull-right">Submit</button>
                </div>
            </form>
        </div>
        <div class="box box-info">
            <div class="box-header with-border"><h3 class="box-title">Single-Node Engine</h3></div>
            <div class="box-body">
                <p class="text-muted small">Multi-node management is disabled in this release. All servers run locally on <strong><%= node.name %></strong> (<code><%= node.fqdn %></code>).</p>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var selectAll = document.getElementById('selectAllAllocations');
    var deleteBtn = document.getElementById('massDeleteAllocationsBtn');
    var countEl = document.getElementById('selectedAllocationsCount');
    var checkboxes = Array.prototype.slice.call(document.querySelectorAll('.allocation-checkbox'));

    if (!selectAll || !deleteBtn || !countEl) return;

    function syncState() {
        var selectable = checkboxes.filter(function (cb) { return !cb.disabled; });
        var checked = selectable.filter(function (cb) { return cb.checked; });
        countEl.textContent = String(checked.length);
        deleteBtn.disabled = checked.length === 0;
        selectAll.disabled = selectable.length === 0;
        selectAll.checked = selectable.length > 0 && checked.length === selectable.length;
        selectAll.indeterminate = checked.length > 0 && checked.length < selectable.length;
    }

    selectAll.addEventListener('change', function () {
        var nextState = selectAll.checked;
        checkboxes.forEach(function (cb) {
            if (!cb.disabled) cb.checked = nextState;
        });
        syncState();
    });

    checkboxes.forEach(function (cb) {
        cb.addEventListener('change', syncState);
    });

    syncState();
})();
</script>

<%- include('partials/footer') %>
