<%- include('partials/header', { title: 'Locations', activeNav: 'locations', contentHeader: '<h1>Locations<small>All locations that nodes can be assigned to for easier categorization.</small></h1><ol class="breadcrumb"><li><a href="/admin">Admin</a></li><li class="active">Locations</li></ol>' }) %>

<div class="row">
    <div class="col-md-8">
        <div class="box box-primary">
            <div class="box-header with-border"><h3 class="box-title">Location List</h3></div>
            <div class="box-body table-responsive no-padding">
                <table class="table table-hover">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <th>Short Code</th>
                            <th>Description</th>
                            <th>Servers</th>
                        </tr>
                        <% for (const loc of locations) { %>
                        <tr>
                            <td><code><%= loc.id %></code></td>
                            <td><code><%= loc.short %></code></td>
                            <td><%= loc.long %></td>
                            <td><%= loc.server_count %></td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="box box-success">
            <div class="box-header with-border"><h3 class="box-title">Create Location</h3></div>
            <form action="/admin/locations" method="POST">
                <div class="box-body">
                    <div class="form-group"><label>Short Code</label><input type="text" name="short" class="form-control" required placeholder="us-east"></div>
                    <div class="form-group"><label>Description</label><input type="text" name="long" class="form-control" required placeholder="US East Datacenter"></div>
                </div>
                <div class="box-footer"><button type="submit" class="btn btn-success btn-sm pull-right">Create</button></div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
