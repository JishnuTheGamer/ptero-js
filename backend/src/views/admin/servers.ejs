<%- include('partials/header', { title: 'Servers', activeNav: 'servers', contentHeader: '<h1>Servers<small>All servers available on the system.</small></h1><ol class="breadcrumb"><li><a href="/admin">Admin</a></li><li class="active">Servers</li></ol>' }) %>

<div class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Server List</h3>
                <div class="box-tools search01">
                    <form action="/admin/servers" method="GET">
                        <div class="input-group input-group-sm">
                            <input type="text" name="query" class="form-control pull-right" value="<%= query %>" placeholder="Search Servers">
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-default"><i class="fa fa-search"></i></button>
                                <a href="/admin/servers/new"><button type="button" class="btn btn-sm btn-primary" style="border-radius: 0 3px 3px 0;margin-left:-1px;">Create New</button></a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="box-body table-responsive no-padding">
                <table class="table table-hover">
                    <tbody>
                        <tr>
                            <th>Server Name</th>
                            <th>UUID</th>
                            <th>Owner</th>
                            <th>Software</th>
                            <th>Connection</th>
                            <th class="text-center">Status</th>
                            <th></th>
                        </tr>
                        <% if (servers.length === 0) { %>
                        <tr><td colspan="7" class="text-muted text-center">No servers have been created yet.</td></tr>
                        <% } %>
                        <% for (const s of servers) { %>
                        <tr>
                            <td><a href="/admin/servers/view/<%= s.id %>"><%= s.name %></a></td>
                            <td><code><%= s.uuid %></code></td>
                            <td><a href="/admin/users/view/<%= s.owner_id %>"><%= s.owner_username %></a></td>
                            <td><span class="label label-info"><%= s.egg_name %></span></td>
                            <td><code><%= s.ip %>:<%= s.port %></code></td>
                            <td class="text-center">
                                <% if (s.status === 'suspended') { %>
                                    <span class="label bg-maroon">Suspended</span>
                                <% } else if (s.status === 'installing') { %>
                                    <span class="label label-warning">Installing</span>
                                <% } else { %>
                                    <span class="label label-success">Active</span>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <a class="btn btn-xs btn-default" href="/server/<%= s.uuidShort %>"><i class="fa fa-wrench"></i></a>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
