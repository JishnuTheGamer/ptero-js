<%- include('partials/header', { title: 'Manager User: ' + user.username, activeNav: 'users', contentHeader: '<h1>' + user.name_first + ' ' + user.name_last + '<small>' + user.username + '</small></h1><ol class="breadcrumb"><li><a href="/admin">Admin</a></li><li><a href="/admin/users">Users</a></li><li class="active">' + user.username + '</li></ol>' }) %>

<div class="row">
    <form action="/admin/users/view/<%= user.id %>" method="POST">
        <div class="col-md-6">
            <div class="box box-primary">
                <div class="box-header with-border"><h3 class="box-title">Identity</h3></div>
                <div class="box-body">
                    <div class="form-group">
                        <label class="control-label">Email</label>
                        <input type="email" name="email" value="<%= user.email %>" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Username</label>
                        <input type="text" name="username" value="<%= user.username %>" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="control-label">First Name</label>
                        <input type="text" name="name_first" value="<%= user.name_first %>" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Last Name</label>
                        <input type="text" name="name_last" value="<%= user.name_last %>" class="form-control" required />
                    </div>
                </div>
                <div class="box-footer">
                    <button type="submit" class="btn btn-primary btn-sm pull-right">Update User</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="box">
                <div class="box-header with-border"><h3 class="box-title">Password & Permissions</h3></div>
                <div class="box-body">
                    <div class="form-group">
                        <label class="control-label">New Password (Optional)</label>
                        <input type="password" name="password" class="form-control" placeholder="Leave blank to keep existing password" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Administrator</label>
                        <select name="root_admin" class="form-control">
                            <option value="0" <%= !user.root_admin ? 'selected' : '' %>>No</option>
                            <option value="1" <%= user.root_admin ? 'selected' : '' %>>Yes</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="col-md-6">
        <div class="box box-danger">
            <div class="box-header with-border"><h3 class="box-title">Delete User</h3></div>
            <div class="box-body">
                <p class="no-margin">There must be no servers associated with this account in order for it to be deleted.</p>
            </div>
            <div class="box-footer">
                <form action="/admin/users/delete/<%= user.id %>" method="POST">
                    <button type="submit" class="btn btn-sm btn-danger pull-right" <%= ownedServers > 0 || user.id === currentUser.id ? 'disabled' : '' %>>Delete User</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
